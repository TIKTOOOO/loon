# TIKTOOOO modified 2026-11-01; AGPL-3.0; upstream mekos2772/ios-location-spoofer
#!name=iOS Location Spoofer
#!desc=拦截 Apple 定位服务回传的坐标并置换为指定位置（Loon 插件）
#!homepage=https://github.com/TIKTOOOO/loon

# 定位修改由网页和快捷指令统一控制：保存地点开始，停止指令结束；未配置远程时放行。
# 服务器保存/停止不代表 iOS 已刷新定位；网络失败可使用最长 5 分钟有效缓存。

[Argument]
configHost = input,"",tag=配置服务器,desc=不要末尾斜杠
configToken = input,"",tag=配置Token,desc=必填才能读 loc.json（与 configUrl 二选一）
configUrl = input,"",tag=远程配置URL,desc=完整 loc.json 地址；与上两项二选一
debug = switch,true,tag=调试日志,desc=建议开启，Loon 日志搜 Location spoofer

[Script]
http-request ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/TIKTOOOO/loon/main/插件/scripts/ios-location-spoofer.js, requires-body=false, timeout=8, tag=iOS Location Spoofer Prepare, argument=[{configHost},{configToken},{configUrl},{debug}]
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://raw.githubusercontent.com/TIKTOOOO/loon/main/插件/scripts/ios-location-spoofer.js, requires-body=true, binary-body-mode=true, timeout=30, tag=iOS Location Spoofer, argument=[{configHost},{configToken},{configUrl},{debug}]
cron "*/15 * * * *" script-path=https://raw.githubusercontent.com/TIKTOOOO/loon/main/插件/scripts/ios-location-spoofer.js, timeout=30, tag=iOS Location Spoofer Sync, argument=[{configHost},{configToken},{configUrl},{debug}]

[mitm]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
